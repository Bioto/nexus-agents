# Multi-stage Dockerfile for building nutrition-mcp-server
# Builds ONLY the x_toolbox crate (nutrition MCP server) - no other workspace crates
#
# Using nightly because rmcp-macros requires edition2024 and home@0.5.12 requires rustc 1.88+
FROM rust:alpine AS builder

# Install build dependencies and switch to nightly toolchain
# (rust:nightly-alpine doesn't exist, so we install nightly via rustup)
RUN apk add --no-cache musl-dev && \
    rustup toolchain install nightly && \
    rustup default nightly

# Set working directory and target directory for cargo
WORKDIR /build
ENV CARGO_TARGET_DIR=/build/target

# Copy ONLY the x_toolbox crate (nutrition MCP server)
# This excludes all other workspace crates (nexus_*, etc.)
COPY src/x_toolbox ./src/x_toolbox

# Transform Cargo.toml: replace `workspace = true` refs with explicit versions
# This allows building without the full workspace while keeping the source file clean
# Workspace dependency versions are defined in the root Cargo.toml:
#   clap = "4", tokio = "1", uuid = "1", reqwest = "0.12"
RUN sed -i \
    -e 's/clap = { workspace = true }/clap = { version = "4", features = ["derive", "env"] }/' \
    -e 's/tokio = { workspace = true, features = \["full"\] }/tokio = { version = "1", features = ["full"] }/' \
    -e 's/uuid = { workspace = true }/uuid = { version = "1", features = ["v4", "serde"] }/' \
    -e 's/reqwest = { workspace = true }/reqwest = { version = "0.12", default-features = false, features = ["json", "stream", "multipart", "rustls-tls"] }/' \
    ./src/x_toolbox/Cargo.toml

# Build only the nutrition-mcp-server binary in release mode
# Uses SQLx offline mode (queries verified against .sqlx cache)
ENV SQLX_OFFLINE=true
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cd src/x_toolbox && \
    cargo build --release --bin nutrition-mcp-server && \
    cp /build/target/release/nutrition-mcp-server /nutrition-mcp-server

# Runtime stage - minimal Alpine image
FROM alpine:3.20 AS runtime

# Install runtime dependencies (ca-certificates for TLS)
RUN apk add --no-cache ca-certificates

# Copy binary from builder
COPY --from=builder /nutrition-mcp-server /usr/local/bin/nutrition-mcp-server

# Set environment variables for database connection
# These can be overridden at runtime via docker run -e or docker-compose
ENV POSTGRES_HOST=postgres
ENV POSTGRES_PORT=5432
ENV POSTGRES_DATABASE=nutrition
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres
ENV DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nutrition

# Expose the MCP server port
EXPOSE 8002

# Run the nutrition-mcp-server with HTTP transport
ENTRYPOINT ["nutrition-mcp-server"]
CMD ["--transport", "http", "--bind", "0.0.0.0:8002"]

# Build instructions:
# From workspace root:
#   docker build -f .docker/Dockerfile.nutrition-mcp -t nutrition-mcp-server .
#
# Run (assuming postgres is accessible at host 'postgres'):
#   docker run --rm -p 8002:8002 \
#     -e POSTGRES_HOST=host.docker.internal \
#     -e DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/nutrition \
#     nutrition-mcp-server
#
# Or use with docker-compose (see .docker/docker-compose.nutrition-mcp.yaml)

