# Nexus Agents Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# Core Configuration
# =============================================================================

# Default LLM model for general text processing
DEFAULT_MODEL=gpt-5-nano-2025-08-07

# =============================================================================
# LLM API Configuration (General Text Processing)
# =============================================================================

# API key for general LLM/text processing
# Falls back to OPENAI_API_KEY if not set (for backward compatibility)
LLM_API_KEY=your_llm_api_key_here

# Base URL for general LLM API
# Falls back to OPENAI_BASE_URL if not set (for backward compatibility)
# Default: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# =============================================================================
# Vision/Image Processing API Configuration
# =============================================================================

# API key for vision/image processing models
# Falls back to LLM_API_KEY or OPENAI_API_KEY if not set
# Use this to specify a different API key for image processing (e.g., OpenAI)
VISION_API_KEY=your_vision_api_key_here

# Base URL for vision/image processing API
# Falls back to LLM_BASE_URL or OPENAI_BASE_URL if not set
# Default: https://api.openai.com/v1
VISION_BASE_URL=https://api.openai.com/v1

# Model for vision/image processing tasks
# Falls back to NEXUS_LOGGER_CLICK_CONTEXT_MODEL if not set
# Default: gpt-4o-mini
VISION_MODEL=gpt-4o-mini

# =============================================================================
# Legacy OpenAI Configuration (Backward Compatibility)
# =============================================================================

# OpenAI API key (deprecated - use LLM_API_KEY instead)
# Kept for backward compatibility, will be used if LLM_API_KEY is not set
# OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Base URL (deprecated - use LLM_BASE_URL instead)
# Kept for backward compatibility, will be used if LLM_BASE_URL is not set
# OPENAI_BASE_URL=https://api.openai.com/v1

# Logging level: trace, debug, info, warn, error
RUST_LOG=info

# =============================================================================
# ClickHouse Database Configuration
# =============================================================================

# ClickHouse server host
CLICKHOUSE_HOST=localhost

# ClickHouse server port
# 9000 = native TCP protocol (default for clickhouse-rs)
# 8123 = HTTP protocol
CLICKHOUSE_PORT=9000

# ClickHouse username (CLICKHOUSE_USER or CLICKHOUSE_USERNAME)
CLICKHOUSE_USER=default
# Alternative: CLICKHOUSE_USERNAME=default

# ClickHouse password
CLICKHOUSE_PASSWORD=default

# ClickHouse database name
CLICKHOUSE_DATABASE=default

# Connection pool size (default: 10)
CLICKHOUSE_POOL_SIZE=10

# =============================================================================
# nexus_logger - Click Context Analysis Configuration
# =============================================================================

# Enable/disable click context analysis
NEXUS_LOGGER_CLICK_CONTEXT_ENABLED=true

# Number of frames to capture per click event (1-6)
# More frames provide more context but use more API tokens
NEXUS_LOGGER_CLICK_CONTEXT_FRAME_COUNT=3

# Delay between capturing frames in milliseconds (minimum 250ms)
# Longer intervals capture changes over more time
NEXUS_LOGGER_CLICK_CONTEXT_FRAME_INTERVAL_MS=1000

# AI model for analyzing individual frames (deprecated - use VISION_MODEL instead)
# Kept for backward compatibility, will be used if VISION_MODEL is not set
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.
NEXUS_LOGGER_CLICK_CONTEXT_MODEL=gpt-4o-mini

# AI model for generating click context summary (deprecated - use VISION_MODEL instead)
# Kept for backward compatibility, will be used if VISION_MODEL is not set
NEXUS_LOGGER_CLICK_CONTEXT_SUMMARY_MODEL=gpt-4o-mini

# Maximum tokens for per-frame analysis
# Lower values reduce cost but may lose detail
NEXUS_LOGGER_CLICK_CONTEXT_FRAME_TOKENS=200

# Maximum tokens for summary generation
NEXUS_LOGGER_CLICK_CONTEXT_SUMMARY_TOKENS=120

# Monitor index to capture from (0-based, optional)
# Leave unset to capture from all monitors
# NEXUS_LOGGER_CLICK_CONTEXT_MONITOR=0

# Directory to save captured frame images (optional)
# Useful for debugging or manual review
# NEXUS_LOGGER_CLICK_CONTEXT_SAVE_FRAMES=/path/to/frames

# =============================================================================
# nexus_screen Configuration (Linux)
# =============================================================================

# Path for pkg-config (if non-standard location)
# PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
